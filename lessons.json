[{"n": "Tanishuv", "i": "👋", "l": [{"t": "Hallo! Salomlashish", "p": [["Hallo!", "Salom!"], ["Guten Morgen!", "Xayrli tong!"], ["Guten Tag!", "Xayrli kun!"], ["Guten Abend!", "Xayrli kech!"], ["Wie geht's?", "Ishlaringiz qalay?"], ["Gut, danke!", "Yaxshi, rahmat!"]], "g": "<b>Guten Tag</b> — rasmiy salom, <b>Hallo</b> — do'stlar orasida."}, {"t": "Ismim ...", "p": [["Wie heißt du?", "Ismingiz nima?"], ["Ich heiße Ali.", "Mening ismim Ali."], ["Und du?", "Sizchi?"], ["Freut mich!", "Tanishganimdan xursandman!"], ["Das ist mein Freund.", "Bu mening do'stim."], ["Wer ist das?", "Bu kim?"]], "g": "<b>ich heiße</b>, <b>du heißt</b>: fe'l shaxsga qarab o'zgaradi."}, {"t": "Qayerdansiz?", "p": [["Woher kommst du?", "Qayerdansiz?"], ["Ich komme aus Usbekistan.", "Men O'zbekistondanman."], ["Wo wohnst du?", "Qayerda yashaysiz?"], ["Ich wohne in Taschkent.", "Men Toshkentda yashayman."], ["Ich spreche Usbekisch.", "Men o'zbekcha gapiraman."], ["Sprichst du Deutsch?", "Nemischa gapirasizmi?"]], "g": "<b>woher</b> — qayerdan, <b>wo</b> — qayerda. Davlat oldidan <b>aus</b>, shahar oldidan <b>in</b>."}, {"t": "Xayrlashish", "p": [["Tschüss!", "Xayr!"], ["Auf Wiedersehen!", "Ko'rishguncha!"], ["Bis morgen!", "Ertagacha!"], ["Danke schön!", "Katta rahmat!"], ["Bitte schön!", "Marhamat!"], ["Entschuldigung!", "Kechirasiz!"]], "g": "<b>Auf Wiedersehen</b> — rasmiy, <b>Tschüss</b> — do'stlar orasida."}, {"t": "O'zim haqimda", "p": [["Ich bin zwanzig Jahre alt.", "Men yigirma yoshdaman."], ["Ich bin Student.", "Men talabaman."], ["Ich lerne Deutsch.", "Men nemis tilini o'rganyapman."], ["Ich habe eine Schwester.", "Mening singlim/opam bor."], ["Ich mag Musik.", "Menga musiqa yoqadi."], ["Das ist toll!", "Bu ajoyib!"]], "g": "Yosh aytilganda <b>haben</b> emas, <b>sein</b> ishlatiladi: Ich <b>bin</b> 20."}]}, {"n": "Sonlar", "i": "🔢", "l": [{"t": "1 dan 6 gacha", "p": [["eins", "bir"], ["zwei", "ikki"], ["drei", "uch"], ["vier", "to'rt"], ["fünf", "besh"], ["sechs", "olti"]], "g": "Sonlarni baland ovozda ayting, 🔊 tugmasi yordam beradi."}, {"t": "7 dan 12 gacha", "p": [["sieben", "yetti"], ["acht", "sakkiz"], ["neun", "to'qqiz"], ["zehn", "o'n"], ["elf", "o'n bir"], ["zwölf", "o'n ikki"]], "g": "<b>elf</b> va <b>zwölf</b> alohida so'zlar, ularni yodlash kerak."}, {"t": "13 dan 20 gacha", "p": [["dreizehn", "o'n uch"], ["vierzehn", "o'n to'rt"], ["fünfzehn", "o'n besh"], ["sechzehn", "o'n olti"], ["siebzehn", "o'n yetti"], ["zwanzig", "yigirma"]], "g": "13-19: son + <b>zehn</b>. E'tibor: sechs → <b>sech</b>zehn, sieben → <b>sieb</b>zehn."}, {"t": "Yigirmalar va yuzlar", "p": [["einundzwanzig", "yigirma bir"], ["dreißig", "o'ttiz"], ["vierzig", "qirq"], ["fünfzig", "ellik"], ["hundert", "yuz"], ["tausend", "ming"]], "g": "Nemischa birlik oldin aytiladi: 21 = <b>einundzwanzig</b> (bir-va-yigirma)."}, {"t": "Yosh va narx", "p": [["Wie alt bist du?", "Yoshingiz nechada?"], ["Ich bin zwanzig.", "Men yigirmadaman."], ["Was kostet das?", "Bu qancha turadi?"], ["Das kostet fünf Euro.", "Bu besh yevro."], ["Wie viel?", "Qancha?"], ["Meine Nummer ist...", "Mening raqamim...."]], "g": "<b>Was kostet das?</b> — do'konda eng kerakli savol."}]}, {"n": "Oila", "i": "👨‍👩‍👧", "l": [{"t": "Ota-ona"}, {"t": "Aka-uka va opa-singil"}, {"t": "Oila a'zolarim"}, {"t": "Qarindoshlar"}, {"t": "Mening oilam"}]}, {"n": "Ovqat", "i": "🍎", "l": [{"t": "Mevalar va sabzavotlar"}, {"t": "Ichimliklar"}, {"t": "Restoranda"}, {"t": "Nonushta va tushlik"}, {"t": "Menyu va hisob"}]}, {"n": "Vaqt va kunlar", "i": "🕒", "l": [{"t": "Hafta kunlari"}, {"t": "Oylar"}, {"t": "Soat necha?"}, {"t": "Kun tartibi"}, {"t": "Ob-havo"}]}, {"n": "Shahar", "i": "🚌", "l": [{"t": "Joylar"}, {"t": "Yo'l so'rash"}, {"t": "Transport"}, {"t": "Chipta olish"}, {"t": "Mehmonxona"}]}, {"n": "Xarid", "i": "🛍", "l": [{"t": "Do'konda"}, {"t": "Kiyimlar"}, {"t": "Ranglar"}, {"t": "Narx va chegirma"}, {"t": "Savdolashish"}]}, {"n": "Uy", "i": "🏠", "l": [{"t": "Xonalar"}, {"t": "Mebellar"}, {"t": "Mening uyim"}, {"t": "Qo'shnilar"}, {"t": "Ijara"}]}, {"n": "Ish", "i": "💼", "l": [{"t": "Kasblar"}, {"t": "Ish joyi"}, {"t": "Suhbat"}, {"t": "Ish kuni"}, {"t": "Ariza"}]}, {"n": "Salomatlik", "i": "🩺", "l": [{"t": "Tana a'zolari"}, {"t": "Shifokorda"}, {"t": "Dorixona"}, {"t": "Kasallik"}, {"t": "Sog'lom turmush"}]}]